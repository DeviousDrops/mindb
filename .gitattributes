# flatc emits LF. Without this, autocrlf checks the generated files out as
# CRLF on Windows and `make check-gen` reports a diff on every line of every
# file, which would make the drift check useless exactly where it is run by
# hand.
pkg/mindb/*.go text eol=lf

# Container and CI files are consumed by Linux tooling that is happier
# without CR, and a CRLF continuation inside a RUN line is a real hazard.
build/Dockerfile text eol=lf
.dockerignore text eol=lf
.github/workflows/*.yml text eol=lf
