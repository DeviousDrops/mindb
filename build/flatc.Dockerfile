# Pinned flatc toolchain, used by `make gen`.
#
# The compiler version must match the FlatBuffers Go runtime in go.mod
# (v25.12.19). Generated code and runtime are a matched pair: a mismatch does
# not fail the build, it shifts vtable offsets and shows up as garbage fields at
# runtime. Pinning the compiler in a container is the only way to get the same
# generated bytes on a developer machine and in CI.
#
# There is no official flatc image, so it is built from the release tag.
FROM alpine:3.21 AS build

ARG FLATBUFFERS_VERSION=v25.12.19

RUN apk add --no-cache cmake make g++ git

RUN git clone --depth 1 --branch "${FLATBUFFERS_VERSION}" \
        https://github.com/google/flatbuffers.git /src \
    && cmake -S /src -B /build \
        -DCMAKE_BUILD_TYPE=Release \
        -DFLATBUFFERS_BUILD_TESTS=OFF \
        -DFLATBUFFERS_BUILD_FLATHASH=OFF \
    && cmake --build /build --target flatc -j "$(nproc)"

FROM alpine:3.21
RUN apk add --no-cache libstdc++
COPY --from=build /build/flatc /usr/local/bin/flatc
ENTRYPOINT ["flatc"]
