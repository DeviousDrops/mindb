    {
      "type": "timeseries",
      "title": "Device write latency",
      "description": "Mean time a write request spent queued and in service, from /proc/diskstats.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
