      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(mindb_wal_bytes_total[$__rate_interval])",
          "legendFormat": "log records"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(mindb_process_io_write_bytes_total[$__rate_interval])",
          "legendFormat": "process to storage"
        }
      ]
    },
    {
      "type": "row",
