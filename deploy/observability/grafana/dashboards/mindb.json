    },
    {
      "type": "timeseries",
      "title": "Utilization and queue depth",
      "description": "Utilization is the share of time with any request in flight; on SSDs and NVMe 100% is not saturation. Queue depth is the better signal.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
