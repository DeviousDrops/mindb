          "expr": "rate(mindb_disk_io_time_seconds_total[$__rate_interval])",
          "legendFormat": "utilization {{device}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(mindb_disk_io_weighted_time_seconds_total[$__rate_interval])",
          "legendFormat": "queue depth {{device}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Device flushes vs MinDB fsyncs",
      "description": "An fsync on a device with a volatile cache ends in a flush. More flushes than fsyncs is other processes and filesystem journal commits.",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
