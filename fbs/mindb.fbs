namespace mindb;

table Vector {
  id: string;
  values: [float32];
  payload: [ubyte];
}

table InsertRequest {
  vectors: [Vector];
}

table InsertResponse {
  inserted_count: int32;
}

table SearchRequest {
  query_vector: [float32];
  top_k: int32;
}

table SearchResult {
  id: string;
  score: float32;
  payload: [ubyte];
}

table SearchResponse {
  results: [SearchResult];
}

table DeleteRequest {
  ids: [string];
}

table DeleteResponse {
  deleted_count: int32;
}

table SnapshotRequest {}
table SnapshotResponse {
  success: bool;
  message: string;
}

// Get returns the stored vectors for the given ids, in request order. Ids that
// are absent are omitted, so vectors may be shorter than ids and is not
// positionally aligned with it. Reuses Vector, so a Get result is wire
// identical to an Insert input.
table GetRequest {
  ids: [string];
}
table GetResponse {
  vectors: [Vector];
}

// Stats reports engine state and which search kernel is live. memory_bytes is
// reserved rather than used: allocation is eager. payload_bytes is the live
// total, payloads being the only thing allocated on demand.
table StatsRequest {}
table StatsResponse {
  vector_count: uint32;
  capacity: uint32;
  dims: uint32;
  memory_bytes: uint64;
  payload_bytes: uint64;
  kernel_name: string;
  fast_int8: bool;
  goarch: string;

  // Whether writes are being logged, and whether every record so far
  // reached the disk. wal_healthy goes false once and stays there; it is
  // what a readiness probe watches.
  wal_enabled: bool;
  wal_healthy: bool;
}

rpc_service VectorService {
  Insert(InsertRequest): InsertResponse;
  Search(SearchRequest): SearchResponse;
  Delete(DeleteRequest): DeleteResponse;
  Snapshot(SnapshotRequest): SnapshotResponse;
  Get(GetRequest): GetResponse;
  Stats(StatsRequest): StatsResponse;
}
